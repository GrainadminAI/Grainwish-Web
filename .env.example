# ========================================================
# Grainwish AI — Environment Configuration Template
# Copy this file to .env (ignored by Git) for local setup
# NEVER commit real credentials, service keys, or secrets!
# ========================================================

# Supabase Connection Settings
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Google OAuth Authentication (GSI / OAuth 2.0)
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# PostHog Analytics & Telemetry (Client-side)
VITE_POSTHOG_KEY=your-posthog-client-api-key
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Server & Admin Security Settings
NODE_ENV=production
PORT=5001
ADMIN_API_KEY=generate-a-strong-random-admin-secret-token-here
ADMIN_EMAILS=admin@grainwish.com,support@grainwish.com
CORS_ALLOWED_ORIGINS=https://www.grainwish.com,https://grainwish.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
