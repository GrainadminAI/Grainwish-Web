# Disable Directory Indexes / Browsing
Options -Indexes

# Block access to hidden files and dotfiles (.env, .git, etc.)
<FilesMatch "^\.">
  Order allow,deny
  Deny from all
</FilesMatch>

# Block access to sensitive configuration files
<FilesMatch "(package\.json|package-lock\.json|\.env|\.example|netlify\.toml|vercel\.json|tsconfig\.json)">
  Order allow,deny
  Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Enforce HTTPS and canonical www.grainwish.com domain (301 Permanent Redirect)
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^grainwish\.com$ [NC]
  RewriteRule ^(.*)$ https://www.grainwish.com/$1 [L,R=301]

  # Block common directory traversal & script injection attempts
  RewriteCond %{QUERY_STRING} (\.\./|<script|%3Cscript|globals|mosconfig) [NC]
  RewriteRule .* - [F]

  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "DENY"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Cross-Origin-Opener-Policy "same-origin-allow-popups"
  Header set X-Permitted-Cross-Domain-Policies "none"
  Header set Permissions-Policy "camera=(self), microphone=(self), geolocation=(), payment=()"
</IfModule>
